# Frontend env vars — Vite exposes only those prefixed with VITE_.
# Copy this file to .env.local and adjust for your environment.

# URL of the FastAPI backend.
VITE_API_URL=http://localhost:8001

# Product wordmark shown in the sidebar (lowercase looks best).
VITE_APP_NAME=nexus

# Assistant display name, used in the UI and the agent's system prompt.
VITE_BOT_NAME=Nexus

# BCP-47 locale used for STT recognition and TTS voice selection.
# Examples: en-US, en-IN, en-GB, hi-IN, es-ES, fr-FR, ja-JP
VITE_DEFAULT_LANG=en-IN

# STT engine: "auto" (browser recognizer for live text; Whisper decides the final
# words when it is fast — a GPU, or hosted on the user's key — and is the fallback
# otherwise), "webspeech" (browser only), or "whisper" (Whisper only, no live text)
VITE_STT_MODE=auto

# TTS voice preference — "female", "male", or a name fragment like "aria", "zira".
# A name fragment wins over the on-device-first heuristic; the default picks
# Aria, which the UI presents as the agent "Zoe".
VITE_TTS_VOICE=aria

# Verbose console logging from the widget.
VITE_DEBUG=true
