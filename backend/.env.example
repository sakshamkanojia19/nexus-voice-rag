# Which provider the server's own key is for: openai | xai | groq. Users who
# bring their own key are routed by its prefix (sk- / xai- / gsk_) instead.
PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o
# Low-latency profile used only for spoken turns.
VOICE_MODEL=gpt-4.1-mini
# Fast lane for greetings/acknowledgements that do not need tools.
QUICK_VOICE_MODEL=gpt-4.1-nano
# Leave blank for non-reasoning voice models.
VOICE_REASONING_EFFORT=

# ── Search modes (the composer's Instant / Web / Deep chips) ────────────────
# Instant: no tools, one pass, answers from the model's own knowledge.
INSTANT_MODEL=gpt-4.1-nano
# Deep research: more tool rounds so the agent can search, read, re-search.
# Defaults to OPENAI_MODEL when unset.
DEEP_MODEL=
DEEP_MAX_ITERATIONS=8
# Thinking Mode. MUST be a reasoning model — the chat models reject
# `reasoning_effort`. Toggling Thinking on a chat model swaps to this one.
THINKING_MODEL=o4-mini
THINKING_EFFORT=medium
# Models the client may select in the picker. Anything not listed is ignored
# and falls back to OPENAI_MODEL.
CHAT_MODELS=gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano,o4-mini

# ── xAI (Grok) and Groq ─────────────────────────────────────────────────────
# Same roles as the OpenAI models above, used when the key is theirs. Model ids
# change often — check each console's model list before relying on these.
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_VOICE_MODEL=grok-4.20-0309-non-reasoning
XAI_QUICK_VOICE_MODEL=grok-4.20-0309-non-reasoning
XAI_INSTANT_MODEL=grok-4.20-0309-non-reasoning
XAI_DEEP_MODEL=grok-4.7
XAI_THINKING_MODEL=grok-4.7
XAI_CHAT_MODELS=grok-4.7,grok-4.6,grok-4.5,grok-4.3,grok-4.20-0309-reasoning,grok-4.20-0309-non-reasoning

# Groq also hosts Whisper, so a Groq key covers STT_BACKEND=openai too.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VOICE_MODEL=openai/gpt-oss-20b
GROQ_QUICK_VOICE_MODEL=openai/gpt-oss-20b
GROQ_INSTANT_MODEL=openai/gpt-oss-20b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
GROQ_THINKING_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

CLAUDE_MODEL=claude-opus-4-7
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# STT_BACKEND=openai (paid, hosted) or local (free, faster-whisper).
# NOTE: the Speech section further down sets these again and wins — edit there.
STT_BACKEND=openai
LOCAL_WHISPER_MODEL=auto
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE=int8
MAX_CONTEXT_TOKENS=8000
WEB_SEARCH_ENABLED=true
HOST=0.0.0.0
PORT=8001
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500

# Qdrant Cloud vector DB — create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://YOUR-CLUSTER.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=nexus_documents

# ── Identity (Supabase) ─────────────────────────────────────────────────────
# Sign-in provider. Leave SUPABASE_URL empty and the app still runs — every
# caller is anonymous, scoped by a server-issued httpOnly cookie — but BYOK is
# then unavailable to everyone, since a key is only accepted from an account.
# The browser needs the matching VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project.supabase.co
# Only for legacy projects that sign tokens with a shared HS256 secret. Projects
# on asymmetric signing keys are verified via JWKS and need nothing here.
SUPABASE_JWT_SECRET=
# Server-side Postgres access. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Browsers reject Secure cookies over plain HTTP, so keep this false for local
# dev and true everywhere that serves HTTPS.
COOKIE_SECURE=false

# ── Access control ──────────────────────────────────────────────────────────
# Require a signed-in account for the routes that spend money or read stored
# data (/chat, /ws, /transcribe, /upload, /documents). Defaults to ON when
# SUPABASE_URL is set, OFF otherwise — so configuring SSO enables it, and a
# deployment with no identity provider can't lock everyone out.
REQUIRE_AUTH=true

# ── BYOK: bring your own key ────────────────────────────────────────────────
# Accept an OpenAI, xAI or Groq key from the caller (header X-Provider-Key),
# used for that request only, never stored or logged, and only ever sent to
# the provider it belongs to.
ALLOW_USER_API_KEYS=true
# Refuse to fall back to the server's own key, so this deployment cannot spend
# your credit on other people's questions. Turn on for any public instance.
REQUIRE_USER_API_KEY=true
# Only honour a caller-supplied key from a signed-in account. Leave this on:
# a key from an unidentified browser belongs to an account nobody can warn or
# revoke, and asking a stranger to paste a credential is the shape of the
# attack the feature invites. Turn off only for a private, single-user box.
REQUIRE_AUTH_FOR_USER_KEY=true

# ── Web search ──────────────────────────────────────────────────────────────
# auto | openai | tavily | scrape.  `scrape` is a last resort: when the engine
# blocks it, it returns unrelated results at HTTP 200 rather than an error.
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MODEL=gpt-4o-mini
# TAVILY_API_KEY=
# Minimum share of query terms a scraped result must contain to be citable.
WEB_SEARCH_MIN_RELEVANCE=0.2

# ── Speech ──────────────────────────────────────────────────────────────────
# local = faster-whisper on this machine (free; downloads weights on first use)
# openai = hosted (paid, faster). VAD/TTS/primary STT are already free in-browser.
STT_BACKEND=local
# auto | tiny | base | small | medium | distil-large-v3 | large-v3-turbo
#
# "auto" reads the device: large-v3-turbo on cuda, base on cpu. Accuracy across
# that range runs from ~13% word error (tiny) to under 4% (turbo), so the
# instinct is to always take the biggest — but on a CPU the latency makes it
# unusable. Measured here, 8 cores at int8, decoding a 4.7s clip:
#
#     base              3.1s   0.7x realtime
#     small             9.1s   1.9x
#     large-v3-turbo   18.2s   3.9x
#     distil-large-v3  21.3s   4.6x
#
# Only `base` finishes faster than the audio it is transcribing. This path runs
# when the browser's own recognizer has failed, so the user is already waiting —
# a twenty-second transcription is a broken voice turn, not an accurate one.
# Set an explicit tier to override; with a GPU, or if you will accept the wait,
# `large-v3-turbo` is the accuracy you want. If it will not load, stt.py steps
# down on its own and reports the substitution on /health.
LOCAL_WHISPER_MODEL=auto
# 0 = let ctranslate2 read the machine.
LOCAL_WHISPER_CPU_THREADS=0
# 5 is the accuracy/latency sweet spot; 1 is greedy decoding — quicker, worse.
LOCAL_WHISPER_BEAM_SIZE=5
# Step down to a smaller model instead of failing when the above will not load.
LOCAL_WHISPER_ALLOW_DOWNGRADE=true
# With STT_BACKEND=openai: may this server run Whisper itself when the user's
# hosted transcription fails (rate limit, no credit, outage, or an xAI key)?
# Default: on for STT_BACKEND=local, off otherwise — so a public deployment
# never spends its own CPU on a user's exhausted quota; the browser's own
# recognizer covers that turn instead.
# LOCAL_STT_FALLBACK=false
# Load the weights at boot, so the first spoken turn isn't the one that waits
# through the download.
LOCAL_WHISPER_WARMUP=true
